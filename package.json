{
  "name": "learn-and-code",
  "homepage": "https://alzeth.github.io/learn-and-code/",
  "version": "1.0.3",
  "description": "Learning platform with code editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alzeth/learn-and-code.git"
  },
  "types": "index.d.ts",
  "author": "Igor Ovcharenko",
  "contributors": ["Igor Ovcharenko <mr.alzeth@gmail.com>"],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href /learn-and-code/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:learn-and-code": "node dist/learn-and-code/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "^21.2.5",
    "@angular/common": "^21.2.7",
    "@angular/compiler": "^21.2.7",
    "@angular/core": "^21.2.7",
    "@angular/forms": "^21.2.7",
    "@angular/platform-browser": "^21.2.7",
    "@angular/platform-server": "^21.2.7",
    "@angular/router": "^21.2.7",
    "@angular/ssr": "^21.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "lucide-angular": "^1.0.0",
    "monaco-editor": "^0.55.1",
    "ngx-monaco-editor-v2": "^21.1.4",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.6",
    "@angular/cli": "^21.2.6",
    "@angular/compiler-cli": "^21.2.7",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.8",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.1.4"
  }
}
