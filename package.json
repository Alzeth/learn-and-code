{
  "name": "learn-and-code",
  "homepage": "https://alzeth.github.io/learn-and-code/",
  "version": "14.0.0",
  "description": "Learning platform with code editor",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alzeth/learn-and-code.git"
  },
  "types": "index.d.ts",
  "author": "Igor Ovcharenko",
  "contributors": [
    "Igor Ovcharenko <mr.alzeth@gmail.com>"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --base-href /learn-and-code/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "serve:ssr:learn-and-code": "node dist/learn-and-code/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@angular/cdk": "^22.0.6",
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/platform-server": "^22.0.8",
    "@angular/router": "^22.0.8",
    "@angular/ssr": "^22.0.8",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^34.0.0",
    "@ng-icons/lucide": "^34.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "marked": "^18.0.6",
    "monaco-editor": "^0.55.1",
    "ngx-markdown": "^21.3.0",
    "ngx-monaco-editor-v2": "^21.1.4",
    "pyodide": "^314.0.2",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@ngx-env/builder": "^21.0.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@tailwindcss/typography": "^0.5.20",
    "@types/express": "^5.0.1",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.5.22",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
